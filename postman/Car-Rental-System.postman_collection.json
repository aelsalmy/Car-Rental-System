{
  "info": {
    "name": "Car Rental System",
    "description": "Manual regression collection for the Car Rental System backend (Express + MySQL). Drive in order: Auth -> Cars -> Reservations -> Reports. Tokens are captured into collection variables by the Auth requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "8e9b5b1c-1c0a-4d6a-9a3c-1a8a3c4f5b00"
  },
  "variable": [
    { "key": "baseUrl", "value": "{{baseUrl}}" },
    { "key": "userToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "carId", "value": "" },
    { "key": "reservationId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": ["// Inherited bearer is filled per-folder; nothing to do here."]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{customerUsername}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"customerInfo\": {\n    \"name\": \"Postman Customer\",\n    \"email\": \"{{customerEmail}}\",\n    \"phone\": \"01000000000\",\n    \"address\": \"1 Postman Lane\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201 or 409 (idempotent)', () => pm.expect([201, 409]).to.include(pm.response.code));",
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('userId');",
                  "  pm.collectionVariables.set('userId', json.userId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (customer)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{customerUsername}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.expect(json.token).to.be.a('string');",
                  "pm.collectionVariables.set('userToken', json.token);",
                  "pm.collectionVariables.set('userId', json.userId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.expect(json.token).to.be.a('string');",
                  "pm.collectionVariables.set('adminToken', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with wrong password (negative)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{customerUsername}}\",\n  \"password\": \"definitely-not-the-password\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rejected with 404 and no token', () => {",
                  "  pm.expect(pm.response.code).to.eql(404);",
                  "  pm.expect(pm.response.json().token).to.be.undefined;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Cars",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "List all cars",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/cars", "host": ["{{baseUrl}}"], "path": ["api", "cars"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 with array body', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});",
                  "const cars = pm.response.json();",
                  "if (cars.length > 0) { pm.collectionVariables.set('carId', cars[0].id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Search cars (category + maxPrice)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/cars/search?category=suv&maxPrice=200",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cars", "search"],
              "query": [
                { "key": "category", "value": "suv" },
                { "key": "maxPrice", "value": "200" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json()).to.be.an('array');"
                ]
              }
            }
          ]
        },
        {
          "name": "Get features list",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/cars/features", "host": ["{{baseUrl}}"], "path": ["api", "cars", "features"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json()).to.include('Bluetooth');"
                ]
              }
            }
          ]
        },
        {
          "name": "Get car by id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/cars/{{carId}}", "host": ["{{baseUrl}}"], "path": ["api", "cars", "{{carId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 with id match', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get('carId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register car (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"Postman Test Car\",\n  \"year\": 2026,\n  \"plateId\": \"PM-{{$timestamp}}\",\n  \"status\": \"active\",\n  \"officeId\": 1,\n  \"dailyRate\": 100,\n  \"category\": \"sedan\",\n  \"transmission\": \"automatic\",\n  \"fuelType\": \"petrol\",\n  \"seatingCapacity\": 5,\n  \"features\": [\"Bluetooth\"],\n  \"description\": \"Inserted by Postman\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/cars", "host": ["{{baseUrl}}"], "path": ["api", "cars"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201 or 400 (duplicate plate)', () => pm.expect([201, 400]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Reservations",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "Create reservation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"carId\": {{carId}},\n  \"startDate\": \"{{startDate}}\",\n  \"endDate\": \"{{endDate}}\",\n  \"totalCost\": 300,\n  \"paymentMethod\": \"cash\",\n  \"paymentStatus\": \"pending\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/reservations", "host": ["{{baseUrl}}"], "path": ["api", "reservations"] }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const fmt = (d) => d.toISOString().slice(0, 10);",
                  "const start = new Date(); start.setDate(start.getDate() + 1);",
                  "const end = new Date(); end.setDate(end.getDate() + 4);",
                  "pm.collectionVariables.set('startDate', fmt(start));",
                  "pm.collectionVariables.set('endDate', fmt(end));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201 or 400/404 (overlap or no inventory)', () => pm.expect([201, 400, 404]).to.include(pm.response.code));",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('reservationId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Reserve with past startDate (negative)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"carId\": {{carId}},\n  \"startDate\": \"2020-01-01\",\n  \"endDate\": \"2020-01-05\",\n  \"totalCost\": 100,\n  \"paymentMethod\": \"cash\",\n  \"paymentStatus\": \"pending\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/reservations", "host": ["{{baseUrl}}"], "path": ["api", "reservations"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('past date rejected by DB trigger', () => pm.expect([400, 500]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "My reservations",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/reservations/my", "host": ["{{baseUrl}}"], "path": ["api", "reservations", "my"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 with array', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel reservation",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/reservations/{{reservationId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservations", "{{reservationId}}", "cancel"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('cancellation accepted or already-completed', () => pm.expect([200, 400, 404]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) {",
                  "  pm.expect(pm.response.json().status).to.eql('cancelled');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get all reservations (admin)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            },
            "url": { "raw": "{{baseUrl}}/api/reservations/getAll", "host": ["{{baseUrl}}"], "path": ["api", "reservations", "getAll"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json()).to.be.an('array');"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin endpoint with customer token (must be 403)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{userToken}}", "type": "string" }]
            },
            "url": { "raw": "{{baseUrl}}/api/reservations/getAll", "host": ["{{baseUrl}}"], "path": ["api", "reservations", "getAll"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('customer token blocked from admin route', () => pm.expect([401, 403]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Reports",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
      },
      "item": [
        {
          "name": "Reservation report",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/reports/reservation", "host": ["{{baseUrl}}"], "path": ["api", "reports", "reservation"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Car report",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/reports/car", "host": ["{{baseUrl}}"], "path": ["api", "reports", "car"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Status report (rented)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/reports/status?status=rented",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "status"],
              "query": [{ "key": "status", "value": "rented" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 with array', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Customer report",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/reports/customer", "host": ["{{baseUrl}}"], "path": ["api", "reports", "customer"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Payment report",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/reports/payment", "host": ["{{baseUrl}}"], "path": ["api", "reports", "payment"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
    }
  ]
}
